---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../utils/formatDate";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = formatDate(post.data.pubDate);
const updatedDate = post.data.updatedDate ? formatDate(post.data.updatedDate) : null;
---

<BaseLayout
  title={`${post.data.title} | Joel Momanyi Nyaosi`}
  description={post.data.description}
  ogType="article"
>

  <!-- Article Header -->
  <article class="page-px container-max" style="padding-top: 8rem; padding-bottom: var(--spacing-section-padding);">

    <header class="max-w-3xl mb-16">
      <!-- Tags -->
      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-3 mb-8">
          {post.data.tags.map((tag) => (
            <span
              class="text-label-caps px-3 py-1"
              style="
                border: 1px solid var(--color-outline-variant);
                color: var(--color-on-surface-variant);
              "
            >
              {tag}
            </span>
          ))}
        </div>
      )}

      <!-- Title -->
      <h1 class="text-display-lg text-balance mb-8" style="color: var(--color-primary);">
        {post.data.title}
      </h1>

      <!-- Description / Lead -->
      <p class="text-body-lg mb-8" style="color: var(--color-on-surface-variant);">
        {post.data.description}
      </p>

      <!-- Meta row -->
      <div
        class="flex flex-col sm:flex-row sm:items-center gap-4 pt-8"
        style="border-top: 1px solid var(--color-outline-variant);"
      >
        <div class="flex items-center gap-4">
          <div>
            <span class="text-label-caps block" style="color: var(--color-on-surface-variant);">
              Joel Momanyi Nyaosi
            </span>
            <time
              datetime={post.data.pubDate.toISOString()}
              class="text-label-caps block mt-1"
              style="color: var(--color-on-surface-variant);"
            >
              {formattedDate}
              {updatedDate && ` · Updated ${updatedDate}`}
            </time>
          </div>
        </div>
      </div>
    </header>

    <!-- Divider -->
    <div style="width: 100%; height: 1px; background-color: var(--color-primary); margin-bottom: 4rem;"></div>

    <!-- Article Body -->
    <div class="prose-content max-w-3xl">
      <Content />
    </div>

    <!-- Back to Insights -->
    <div
      class="mt-16 pt-8"
      style="border-top: 1px solid var(--color-outline-variant);"
    >
      <a
        href="/blog"
        class="group inline-flex items-center gap-2 text-label-caps transition-colors duration-200"
        style="color: var(--color-on-surface-variant);"
        onmouseover="this.style.color='var(--color-primary)'"
        onmouseout="this.style.color='var(--color-on-surface-variant)'"
      >
        <span
          class="material-symbols-outlined transition-transform group-hover:-translate-x-1"
          style="font-size: 1rem;"
        >
          arrow_back
        </span>
        Back to Insights
      </a>
    </div>

  </article>

</BaseLayout>

<style>
  /* Minimal, typographically precise prose styles */
  .prose-content {
    color: var(--color-on-surface);
    font-family: var(--font-family-sans);
    font-size: var(--font-size-body-lg);
    line-height: var(--line-height-body-lg);
  }

  .prose-content h1,
  .prose-content h2,
  .prose-content h3,
  .prose-content h4 {
    font-family: var(--font-family-display);
    color: var(--color-primary);
    margin-top: 3rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .prose-content h1 { font-size: var(--font-size-headline-lg); font-weight: 700; }
  .prose-content h2 { font-size: var(--font-size-headline-md); font-weight: 700; }
  .prose-content h3 { font-size: 1.25rem; font-weight: 700; }

  .prose-content p {
    margin-bottom: 1.5rem;
    color: var(--color-on-surface);
  }

  .prose-content a {
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }
  .prose-content a:hover { color: var(--color-primary); }

  .prose-content ul,
  .prose-content ol {
    margin-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose-content li { margin-bottom: 0.5rem; }

  .prose-content blockquote {
    border-left: 4px solid var(--color-primary);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--color-on-surface-variant);
  }

  .prose-content code {
    font-size: 0.875rem;
    background-color: var(--color-surface-container);
    padding: 0.125rem 0.375rem;
    border-radius: 2px;
  }

  .prose-content pre {
    background-color: var(--color-inverse-surface);
    color: var(--color-inverse-on-surface);
    padding: 1.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .prose-content pre code {
    background: none;
    padding: 0;
    font-size: 0.9rem;
  }

  .prose-content hr {
    border: none;
    border-top: 1px solid var(--color-outline-variant);
    margin: 3rem 0;
  }

  .prose-content strong { color: var(--color-primary); font-weight: 600; }
</style>
