---
// Footer.astro — Full footer from Stitch design (insights_hub variant)
---

<footer
  class="w-full page-px section-py flex flex-col md:flex-row justify-between items-start gap-8"
  style="background-color: var(--color-surface); border-top: 1px solid var(--color-primary);"
>
  <!-- Brand Column -->
  <div class="flex flex-col gap-4 max-w-xs">
    <a href="/" class="text-headline-md text-primary font-bold tracking-tighter uppercase hover:opacity-70 transition-opacity">
      Joel Momanyi Nyaosi
    </a>
    <p class="text-body-md" style="color: var(--color-on-surface-variant);">
      Structural intelligence for the digital enterprise.
    </p>
  </div>

  <!-- Link Columns -->
  <div class="flex flex-col md:flex-row gap-10 md:gap-16 w-full md:w-auto md:justify-end">
    <div class="flex flex-col gap-4">
      <span
        class="text-label-caps text-primary pb-2 mb-1"
        style="border-bottom: 1px solid var(--color-outline-variant);"
      >
        Legal &amp; Protocol
      </span>
      <a href="/privacy" class="text-label-caps hover:text-primary underline transition-all" style="color: var(--color-on-surface-variant);">
        Privacy Policy
      </a>
      <a href="/terms" class="text-label-caps hover:text-primary underline transition-all" style="color: var(--color-on-surface-variant);">
        Terms of Engagement
      </a>
    </div>

    <div class="flex flex-col gap-4">
      <span
        class="text-label-caps text-primary pb-2 mb-1"
        style="border-bottom: 1px solid var(--color-outline-variant);"
      >
        Network
      </span>
      <a href="/sitemap.xml" class="text-label-caps hover:text-primary underline transition-all" style="color: var(--color-on-surface-variant);">
        Sitemap
      </a>
      <a
        href="https://linkedin.com/in/jomomanyi"
        target="_blank"
        rel="noopener noreferrer"
        class="text-label-caps hover:text-primary underline transition-all"
        style="color: var(--color-on-surface-variant);"
      >
        LinkedIn
      </a>
    </div>
  </div>

  <!-- Copyright row — spans full width on mobile -->
  <div class="w-full md:w-auto mt-6 md:mt-auto pt-6 md:pt-0" style="border-top: 1px solid var(--color-outline-variant);" data-footer-copyright>
    <p class="text-body-md text-sm" style="color: var(--color-on-surface-variant);">
      &copy; {new Date().getFullYear()} Joel Momanyi Nyaosi. All rights reserved.
    </p>
  </div>
</footer>

<style>
  @media (min-width: 768px) {
    [data-footer-copyright] {
      border-top: none;
    }
  }
</style>
