---
// TrustMetrics.astro — Social proof bar beneath the hero
const metrics = [
  "15+ Years of Execution",
  "50+ Verified Tech Stacks",
  "12 Industries Calibrated",
  "$200M+ Capital Transformed",
];
---

<section
  class="page-px"
  style="
    border-top: 1px solid var(--color-primary);
    border-bottom: 1px solid var(--color-primary);
    padding-top: 2rem;
    padding-bottom: 2rem;
    background-color: var(--color-surface-container-lowest);
  "
  aria-label="Trust metrics"
>
  <div
    class="container-max flex flex-col md:flex-row flex-wrap justify-between items-center gap-6 text-center md:text-left"
  >
    {metrics.map((metric) => (
      <div class="text-label-caps tracking-widest" style="color: var(--color-primary);">
        {metric}
      </div>
    ))}
  </div>
</section>
